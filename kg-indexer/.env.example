# kg-indexer — Environment Variables
# Copy to .env and fill in values.

# === Database ===

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# === Kafka ===

# Kafka broker address
KAFKA_BROKER=localhost:9092

# Consumer group ID
# KAFKA_GROUP_ID=kg-indexer

# === Topic Routing ===

# Environment for Kafka topic prefix (required in production; read by hermes-kafka)
# Must be "staging" or "production"
# ENVIRONMENT=staging

# === Processing ===

# Stale block detection timeout in ms
# BLOCK_STALE_TIMEOUT_MS=1000

# Tally worker run interval in ms
# TALLY_WORKER_INTERVAL_MS=5000

# Tally worker batch size
# TALLY_WORKER_BATCH_SIZE=1000

# === Logging ===

# Emit per-event event-id logs (off by default)
# LOG_EVENT_IDS=true

# === Telemetry (optional) ===

# Sentry DSN (enables Sentry when set)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_SEND_DEFAULT_PII=false
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# SENTRY_DEBUG=false
