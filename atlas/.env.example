# Atlas — Environment Variables
# Copy to .env and fill in values.

# === Stream Source ===

# Use mock stream instead of live substreams (set to "true" or "1")
# USE_MOCK=true

# Substreams gRPC endpoint URL
# SUBSTREAMS_ENDPOINT=https://geotest.substreams.pinax.network:443

# Auth token for substreams endpoint (read by hermes-relay)
# SUBSTREAMS_API_TOKEN=

# Block number to start from
# SUBSTREAMS_START_BLOCK=82655

# Block number to stop at (default: continuous)
# SUBSTREAMS_END_BLOCK=

# === Kafka ===

# Kafka bootstrap server address
KAFKA_BROKER=localhost:9092

# Topic to publish canonical graph updates
# KAFKA_TOPIC=topology.canonical

# === Topic Routing ===

# Environment for Kafka topic prefix (required in production; read by hermes-kafka)
# Must be "staging" or "production"
# ENVIRONMENT=staging

# === Space Configuration ===

# Root space ID as 32-char hex (16 bytes, required)
ROOT_SPACE_ID=0x...

# === Checkpoint Persistence (optional) ===

# PostgreSQL URL for checkpoint persistence (enables checkpointing when set)
# ATLAS_CHECKPOINT_DATABASE_URL=postgresql://user:password@host:5432/dbname

# Indexer ID (required and non-empty when checkpoint persistence is enabled)
# ATLAS_INDEXER_ID=

# Runtime marker for checkpoint compatibility validation
# ATLAS_RUNTIME_COMPATIBILITY_MARKER=atlas-v1

# If true, incompatible/corrupt checkpoints fall back to fresh bootstrap
# ATLAS_CHECKPOINT_ALLOW_FRESH_START=false

# Max uncheckpointed blocks before Atlas pauses processing
# ATLAS_FAIL_OPEN_BOUND=10

# Retry attempts for checkpoint writes
# ATLAS_CHECKPOINT_RETRY_ATTEMPTS=3

# Base retry backoff in milliseconds
# ATLAS_CHECKPOINT_RETRY_BACKOFF_MS=200

# Max paused recovery attempts before returning an error
# ATLAS_PAUSE_RECOVERY_MAX_ATTEMPTS=120

# === Connection Pool (optional) ===

# Checkpoint Postgres pool max connections
# ATLAS_CHECKPOINT_POOL_MAX_CONNECTIONS=2

# Checkpoint Postgres pool min connections
# ATLAS_CHECKPOINT_POOL_MIN_CONNECTIONS=0

# Pool acquire timeout in ms
# ATLAS_CHECKPOINT_POOL_ACQUIRE_TIMEOUT_MS=5000

# Pool idle timeout in ms
# ATLAS_CHECKPOINT_POOL_IDLE_TIMEOUT_MS=60000

# Pool max connection lifetime in ms
# ATLAS_CHECKPOINT_POOL_MAX_LIFETIME_MS=1800000

# Per-connection PostgreSQL statement timeout in ms
# ATLAS_CHECKPOINT_STATEMENT_TIMEOUT_MS=3000

# === Telemetry (optional) ===

# Sentry DSN (enables Sentry when set)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_SEND_DEFAULT_PII=false
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# SENTRY_DEBUG=false
