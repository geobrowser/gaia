# Actions Indexer Environment Configuration
# Copy this file to .env and fill in your values

DATABASE_URL=postgresql://user:password@localhost:5432/actions_indexer

# DATA SOURCE SELECTION (Required)
# Choose the data source for action events:
# - "kafka" = Consume from Hermes Kafka stream (recommended for production)
# - "substreams" = Consume directly from blockchain via Substreams
DATA_SOURCE=kafka

# KAFKA CONFIGURATION (Required when DATA_SOURCE=kafka)
# Kafka broker address
KAFKA_BROKER=localhost:9092

# Consumer group ID - must be stable across restarts for offset tracking
KAFKA_CONSUMER_GROUP=actions-indexer

# Topic to consume vote events from
KAFKA_TOPIC=curation.votes

# Optional: SASL authentication for managed Kafka (e.g., Confluent Cloud)
# KAFKA_USERNAME=your-api-key
# KAFKA_PASSWORD=your-api-secret

# Optional: Custom CA certificate for SSL (PEM format, single line with \n)
# KAFKA_SSL_CA_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# =============================================================================
# SUBSTREAMS CONFIGURATION (Required when DATA_SOURCE=substreams)
# =============================================================================
# Uncomment these if using DATA_SOURCE=substreams
# SUBSTREAMS_ENDPOINT=https://mainnet.eth.streamingfast.io:443
# SUBSTREAMS_API_TOKEN=your-substreams-api-token
