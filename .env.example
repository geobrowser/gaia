# =============================================================================
# Gaia Docker Compose — Environment Variables
# =============================================================================
# Copy this file to .env and fill in required values:
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set for the associated services to start.
# Variables marked [OPTIONAL] have sensible defaults.

# =============================================================================
# Substreams (required for hermes-pipeline, atlas, hermes-ipfs-cache)
# =============================================================================

# [REQUIRED] Substreams API endpoint URL
SUBSTREAMS_ENDPOINT=https://geotest.substreams.pinax.network:443

# [REQUIRED] Authentication token for Substreams API access
SUBSTREAMS_API_TOKEN=

# =============================================================================
# Atlas
# =============================================================================

# [REQUIRED] 32-char hex root space identifier
ROOT_SPACE_ID=41e851610e13a19441c4d980f2f2ce6b

# =============================================================================
# IPFS (optional)
# =============================================================================

# [OPTIONAL] IPFS gateway for content fetching (hermes-ipfs-cache)
# IPFS_GATEWAY_URL=https://gateway.mesh3.network/ipfs/

# [OPTIONAL] Pinata JWT token — IPFS write routes disabled without it (api)
# IPFS_KEY=

# [OPTIONAL] Pinata upload gateway URL (api)
# IPFS_GATEWAY_WRITE=

# =============================================================================
# Search (optional)
# =============================================================================

# [OPTIONAL] OpenSearch index alias (search-indexer)
# INDEX_ALIAS=entities

# =============================================================================
# Scoring (optional)
# =============================================================================

# [OPTIONAL] Output mode: postgres, kafka, or all (scoring-cronjob)
# OUTPUT_MODE=all

# [OPTIONAL] Batch size for score processing (scoring-cronjob)
# SCORE_BATCH_SIZE=1000

# =============================================================================
# Proposal Executor (required only with --profile executor)
# =============================================================================

# [REQUIRED for executor] 32-byte hex private key, 0x-prefixed
# EXECUTOR_PRIVATE_KEY=0x...

# [REQUIRED for executor] Pimlico bundler/paymaster API key (pim_...)
# PIMLICO_API_KEY=pim_...

# [REQUIRED for executor] Chain RPC endpoint URL
# RPC_URL=https://...

# [OPTIONAL] Executor space ID — bytes16, 0x-prefixed
# EXECUTOR_SPACE_ID=

# [OPTIONAL] Space registry contract address
# SPACE_REGISTRY_ADDRESS=0xB01683b2f0d38d43fcD4D9aAB980166988924132

# [OPTIONAL] Chain ID (default: 19411 testnet)
# CHAIN_ID=19411

# =============================================================================
# Telemetry — Sentry (optional, all services)
# =============================================================================

# [OPTIONAL] Sentry DSN URL — telemetry disabled if empty
# SENTRY_DSN=
