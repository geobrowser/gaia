# Search Indexer Configuration
# Copy this file to .env and update with your values

# ============================================================================
# OpenSearch Configuration
# ============================================================================

# OpenSearch server URL
OPENSEARCH_URL=http://localhost:9200

# Index alias name (e.g., "entities")
INDEX_ALIAS=entities

# Index version number for index management
ENTITIES_INDEX_VERSION=0

# Connection mode: "fail-fast" (exit on error) or "retry" (keep retrying)
OPENSEARCH_CONNECTION_MODE=retry

# Retry interval in seconds when connection fails (used when mode is "retry")
OPENSEARCH_RETRY_INTERVAL_SECS=15

# ============================================================================
# Kafka Configuration
# ============================================================================

# Kafka broker addresses (comma-separated)
KAFKA_BROKER=localhost:9092

# Consumer group ID
KAFKA_GROUP_ID=search-indexer

# Entity events topic name
KAFKA_TOPIC=knowledge.edits

# Batch size for entity event consumption (number of messages)
KAFKA_BATCH_SIZE=50

# Batch timeout in milliseconds for entity events
KAFKA_BATCH_TIMEOUT_MS=1000

# Score updates topic name
SCORES_KAFKA_TOPIC=curation.scores

# Batch size for score event consumption
SCORES_BATCH_SIZE=50

# Batch timeout in milliseconds for score events
SCORES_BATCH_TIMEOUT_MS=1000

# ============================================================================
# Kafka Authentication (Optional - for SASL/SSL)
# ============================================================================

# SASL username (required for SASL/SSL authentication)
# KAFKA_USERNAME=your-username

# SASL password (required for SASL/SSL authentication)
# KAFKA_PASSWORD=your-password

# Custom CA certificate PEM (optional, for SSL)
# KAFKA_SSL_CA_PEM=/path/to/ca-cert.pem

# ============================================================================
# Health Check Server
# ============================================================================

# HTTP port for health check endpoints (/healthz, /readyz)
HEALTH_PORT=8080

# ============================================================================
# Telemetry and Monitoring - Sentry Integration
# ============================================================================

# Sentry DSN for error tracking and performance monitoring
# If not set, telemetry defaults to Console backend (stdout logging)
# Example: SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_DSN=

# Trace sampling rate (0.0 to 1.0)
# Controls what percentage of transactions are sent to Sentry
# Recommended values:
#   Development: 1.0 (100% - capture everything for debugging)
#   Staging: 0.5 (50% - balance coverage and volume)
#   Production: 0.1 (10% - sufficient for high-volume Kafka processing)
# Default: 1.0
SENTRY_TRACES_SAMPLE_RATE=1.0

# Send personally identifiable information (PII) to Sentry
# Set to "true" or "1" to enable, any other value disables
# Default: false
# SENTRY_SEND_DEFAULT_PII=false

# Environment name for Sentry (e.g., "development", "staging", "production")
# Helps filter and organize events in Sentry dashboard
# SENTRY_ENVIRONMENT=development

# Release version for Sentry (e.g., "search-indexer@1.2.3")
# Used to track which version produced errors
# SENTRY_RELEASE=search-indexer@1.0.0

# Enable debug mode - logs spans to stdout in addition to sending to Sentry
# Set to "true" or "1" to enable, any other value disables
# Useful for verifying instrumentation locally
# Default: false
# SENTRY_DEBUG=false

# ============================================================================
# Telemetry Notes
# ============================================================================
#
# Console Backend (default):
# - Used when SENTRY_DSN is not set
# - Outputs structured logs to stdout
# - Suitable for local development and simple deployments
#
# Sentry Backend:
# - Enabled by setting SENTRY_DSN
# - Provides distributed tracing, error tracking, and performance monitoring
# - Spans track: batch consumption, event processing, bulk operations
# - View traces in Sentry's Performance dashboard
#
# Sampling Strategy:
# - Lower sampling in production reduces costs and Sentry event volume
# - High-volume Kafka processing generates many traces
# - 10% sampling (0.1) provides sufficient coverage for monitoring
# - Use 100% sampling (1.0) during initial deployment or debugging
