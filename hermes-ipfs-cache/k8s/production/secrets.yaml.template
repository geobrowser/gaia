# Template for hermes-ipfs-cache secrets
# Apply with: kubectl apply -f secrets.yaml -n knowledge
#
# Required values:
# - AMP_FLIGHT_URL: Amp Flight SQL URL (e.g., http://amp-flight:1602)
# - IPFS_GATEWAY_URL: IPFS gateway URL (e.g., https://ipfs.io)
apiVersion: v1
kind: Secret
metadata:
  name: hermes-ipfs-cache-secrets
  namespace: knowledge
type: Opaque
stringData:
  AMP_FLIGHT_URL: "http://amp-flight:1602"
  AMP_DATASET: "geo/actions"
  AMP_START_BLOCK: "82656"
  IPFS_GATEWAY_URL: "https://ipfs.io"
