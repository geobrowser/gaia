# Install dependencies
setup:
    uv sync

# Install all dependencies including dev
setup-dev:
    uv sync --all-extras

# Run the application
run:
    uv run python main.py

# Run tests
test:
    uv run --extra dev pytest

# Run with Docker Compose
docker-run:
    docker compose up --build -d && docker compose logs -f

db-up:
    docker run --name pg_scoring_service \
        -e POSTGRES_PASSWORD=postgres \
        -e POSTGRES_USER=postgres \
        -e POSTGRES_DB=postgres \
        -p 5432:5432 -d postgres:16

db-down:
    docker stop pg_scoring_service && docker rm pg_scoring_service

db-restart:
    just db-down db-up db-migrate

db-migrate:
    cd ../api && bun install && bun run db:migrate

db-load-dump path:
    docker exec -i pg_scoring_service psql -U postgres -d postgres < {{path}}

# Generate protobuf code from scoring.proto, protoc must be installed
proto-gen:
    protoc --proto_path=../hermes-schema/proto --python_out=src/pb ../hermes-schema/proto/scoring.proto

# Start Kafka infrastructure (Kafka + Kafka UI)
kafka-up:
    cd ../.. && docker compose --profile infra --profile tools up kafka kafka-ui -d
    @echo "Waiting for Kafka to be healthy..."
    @until docker compose -f ../../docker-compose.yml exec kafka /opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:9092 > /dev/null 2>&1; do sleep 2; done
    @echo "Kafka is ready!"
    @echo "Kafka UI available at http://localhost:8080"

# Stop Kafka infrastructure
kafka-down:
    cd ../.. && docker compose stop kafka kafka-ui

# Run scoring service with Kafka output (requires DATABASE_URL)
run-scoring-kafka:
    OUTPUT_MODE=kafka \
    KAFKA_BROKER=localhost:9092 \
    KAFKA_TOPIC=curation.scores \
    uv run python main.py

# Run scoring service with both Postgres and Kafka output (requires DATABASE_URL)
run-scoring-all:
    OUTPUT_MODE=all \
    KAFKA_BROKER=localhost:9092 \
    KAFKA_TOPIC=curation.scores \
    uv run python main.py