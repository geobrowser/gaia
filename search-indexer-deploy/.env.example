# Environment variables for docker-compose local development
# Copy this file to .env and update with your values

# ============================================================================
# Sentry Telemetry (Optional)
# ============================================================================
# Uncomment and set SENTRY_DSN to enable Sentry integration
# Without SENTRY_DSN, the indexer uses Console backend (stdout logging)

# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=local-docker
# SENTRY_RELEASE=search-indexer@dev
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_SEND_DEFAULT_PII=false
# SENTRY_DEBUG=true

# ============================================================================
# Index Configuration (Optional)
# ============================================================================
# Customize index settings if needed

# INDEX_ALIAS=entities
# ENTITIES_INDEX_VERSION=0

# ============================================================================
# Kafka Configuration (Optional)
# ============================================================================
# Override Kafka broker if not using the default hermes network

# KAFKA_BROKER=kafka:29092
