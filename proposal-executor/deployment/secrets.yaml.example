# Template for proposal-executor secrets.
# Real secrets are managed externally — DO NOT commit actual values.
#
# kubectl create secret generic proposal-executor-credentials \
#   --namespace=proposal-executor \
#   --from-literal=DATABASE_URL='postgresql://...' \
#   --from-literal=EXECUTOR_PRIVATE_KEY='0x...' \
#   --from-literal=PIMLICO_API_KEY='pim_...'

apiVersion: v1
kind: Secret
metadata:
  name: proposal-executor-credentials
  namespace: proposal-executor
type: Opaque
stringData:
  DATABASE_URL: "postgresql://readonly_user:password@host:5432/dbname"
  EXECUTOR_PRIVATE_KEY: "0x..."
  PIMLICO_API_KEY: "pim_..."
